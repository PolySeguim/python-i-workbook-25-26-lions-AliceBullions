#a fruitful intercept function that will find the y-intercept 
#given the two points (x1, y1, x2, y2)
#*** returns the y-int 
#*** This functin should call the slope function in order to 
#*** calculate the y-intercept or b-value 
def y_int(x1,x2,y1,y2):
    m=slope(x1,x2,y1,y2)
    b=y1-m*x1
    return b

