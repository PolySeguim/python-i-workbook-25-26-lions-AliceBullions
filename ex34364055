def triangleType():
    angle1=float(input("What is the length of angle 1?"))
    angle2=float(input("What is the length of angle 2?"))
    angle3=float(input("What is the length of angle 3?"))
    if angle1==angle2==angle3:
        print("the triangle is equilateral")
    elif angle1==angle2:
        print("the triangle is isosceles")
    elif angle2==angle3:
        print("the triangle is isoceles")
    elif angle1==angle3:
        print("the triangle is isosceles")
    else:
        print("the triangle is scalene")

triangleType()
